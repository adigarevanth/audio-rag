# HuggingFace token — required for pyannote.audio speaker diarization
# 1. Create a free account at https://huggingface.co
# 2. Accept the model terms at https://huggingface.co/pyannote/speaker-diarization-3.1
# 3. Accept the model terms at https://huggingface.co/pyannote/segmentation-3.0
# 4. Create an access token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Postgres connection (matches docker-compose.yml defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=audio_rag
POSTGRES_USER=audio_rag
POSTGRES_PASSWORD=audio_rag_dev

# Whisper model size: tiny, base, small, medium, large-v3
# "base" is a good default for CPU. Use "small" for better accuracy.
WHISPER_MODEL=base

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2
